  "spacing": 8,
  "alignment": "leading"
 },
 "data": {},
 "state": {
  "count": 0
 },
 "script": "function inc(h){ return {state:{count: h.state.count + 1}}; }\nfunction dec(h){ return {state:{count: Math.max(0, h.state.count - 1)}}; }\nfunction reset(h){ return {state:{count: 0}}; }"
}