[
  {
    "op": "define",
    "components": {
      "StatusPill": {
        "props": {
          "text": "",
          "tint": "green"
        },
        "body": {
          "Text": "$text",
          "font": "caption.bold",
          "foregroundStyle": "$tint",
          "padding": {
            "horizontal": 8,
            "vertical": 4
          },
          "background": "${tint + '@0.15'}",
          "clipShape": "capsule"
        }
      },
      "Flight": {
        "props": {
          "number": "",
          "airline": "",
          "from": "",
          "fromCity": "",
          "to": "",
          "toCity": "",
          "departs": null,
          "arrives": null,
          "gate": null,
          "seat": "",
          "status": "On time"
        },
        "body": {
          "Card": [
            {
              "HStack": [
                {
                  "Label": [
                    "$airline · $number",
                    "airplane"
                  ],
                  "font": "subheadline.semibold",
                  "foregroundStyle": "secondary"
                },
                {
                  "Spacer": {}
                },
                {
                  "StatusPill": {
                    "text": "$status",
                    "tint": "${status == 'On time' ? 'green' : status == 'Boarding' ? 'blue' : 'orange'}"
                  }
                }
              ]
            },
            {
              "HStack": [
                {
                  "VStack": [
                    {
                      "Text": "$from",
                      "font": {
                        "size": 40,
                        "weight": "bold",
                        "design": "rounded"
                      }
                    },
                    {
                      "Text": "$fromCity",
                      "font": "caption",
                      "foregroundStyle": "secondary"
                    }
                  ],
                  "alignment": "leading",
                  "spacing": 0
                },
                {
                  "VStack": [
                    {
                      "Image": "airplane",
                      "font": "title3",
                      "foregroundStyle": "accent"
                    },
                    {
                      "Text": "${date(departs, 'time')} – ${date(arrives, 'time')}",
                      "font": "caption2",
                      "foregroundStyle": "secondary"
                    }
                  ],
                  "spacing": 4,
                  "maxWidth": "infinity"
                },
                {
                  "VStack": [
                    {
                      "Text": "$to",
                      "font": {
                        "size": 40,
                        "weight": "bold",
                        "design": "rounded"
                      }
                    },
                    {
                      "Text": "$toCity",
                      "font": "caption",
                      "foregroundStyle": "secondary"
                    }
                  ],
                  "alignment": "trailing",
                  "spacing": 0
                }
              ]
            },
            {
              "Divider": {}
            },
            {
              "Grid": [
                [
                  {
                    "Text": "Departs in",
                    "font": "caption",
                    "foregroundStyle": "secondary"
                  },
                  {
                    "Text": "Gate",
                    "font": "caption",
                    "foregroundStyle": "secondary"
                  },
                  {
                    "Text": "Seat",
                    "font": "caption",
                    "foregroundStyle": "secondary"
                  }
                ],
                [
                  {
                    "Text": {
                      "countdown": "$departs"
                    },
                    "font": "title3.bold.rounded",
                    "monospacedDigit": true
                  },
                  {
                    "Text": "${gate ? gate : '—'}",
                    "font": "title3.bold.rounded",
                    "foregroundStyle": "${gate ? 'primary' : 'tertiary'}",
                    "contentTransition": "numericText"
                  },
                  {
                    "Text": "$seat",
                    "font": "title3.bold.rounded"
                  }
                ]
              ],
              "hSpacing": 28,
              "vSpacing": 2
            }
          ]
        }
      }
    }
  },
  {
    "op": "say",
    "id": "flight",
    "text": "Your Lisbon flight tomorrow morning. I'll keep this card updated until you board.",
    "card": {
      "view": {
        "VStack": [
          {
            "Flight": "$flight"
          },
          {
            "HStack": [
              {
                "Button": "Directions to CDG",
                "symbol": "car.fill",
                "style": "glass",
                "action": {
                  "directions": {
                    "lat": 49.0097,
                    "lon": 2.5479,
                    "name": "Paris Charles de Gaulle"
                  }
                }
              },
              {
                "Button": "Boarding pass",
                "symbol": "wallet.pass.fill",
                "style": "glass",
                "action": {
                  "send": {
                    "intent": "boarding-pass"
                  },
                  "say": "Can you send me the boarding pass?"
                }
              }
            ],
            "spacing": 8
          }
        ],
        "spacing": 12,
        "alignment": "leading"
      },
      "data": {
        "flight": {
          "number": "TP 1235",
          "airline": "TAP",
          "from": "CDG",
          "fromCity": "Paris",
          "to": "LIS",
          "toCity": "Lisbon",
          "departs": "2026-10-24T08:40:00+02:00",
          "arrives": "2026-10-24T10:15:00+01:00",
          "seat": "14A",
          "status": "On time"
        }
      }
    }
  }
]
